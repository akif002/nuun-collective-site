---
import DepthIntro from "../components/DepthIntro.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Nuun Collective is a Dallas-based Muslim community think tank for events, writing, media, and action."
    />
    <title>Nuun Collective</title>
    <!-- Start of CharityStack Embed -->
    <script
      type="text/javascript"
      defer
      id="charitystack-embed"
      data-id="org_VWighWRyUt"
      src="https://prod-donation-elements-b-donationelementsjsfilesb-1m4f4dl6p6b21.s3.us-east-2.amazonaws.com/bundle.js"
      is:inline
    ></script>
    <!-- End of CharityStack Embed-->
    <script defer src="/script.js" is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <a class="brand-logo small" href="#top" aria-label="Nuun Collective home">
        <img src="/assets/logos/nuun-wordmark-orange.png" alt="Nuun" />
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#writing">Writing</a>
        <a href="#media">Media</a>
        <a href="#support">Donate</a>
      </nav>
      <div class="header-actions">
        <button class="button button-donate" type="button" data-donate>Donate</button>
        <a
          class="button button-follow header-follow"
          href="https://www.instagram.com/nuun.collective/"
          target="_blank"
          rel="noreferrer"
        >
          Follow
        </a>
      </div>
    </header>

    <main id="main">
      <DepthIntro />

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner">
          <div class="hero-copy reveal">
            <h1 id="hero-title">
              Bridging engagement with tangible outcomes to solve local challenges.
            </h1>
            <p class="hero-subtext">
              Nuun Collective brings Muslims into serious rooms for conversation, writing, media,
              and action.
            </p>
            <div class="actions">
              <a class="button button-secondary" href="https://www.nuuncollective.com/" target="_blank" rel="noreferrer">
                Read Nuun
              </a>
              <button class="button button-donate" type="button" data-donate>Donate</button>
            </div>
          </div>

          <div class="hero-logo reveal" aria-hidden="true">
            <div class="logo-panel">
              <img src="/assets/logos/nuun-wordmark-orange.png" alt="" />
            </div>
          </div>
        </div>
      </section>

      <section class="section problem-section" id="problem" aria-labelledby="problem-title">
        <div class="problem-gallery reveal" aria-label="Nuun Collective community moments">
          <img
            src="/assets/gallery/nuun-community-sunni-shia.png"
            alt="Panelists seated beneath a projected Sunni and Shia dialogue title"
          />
          <img
            src="/assets/gallery/nuun-community-paradigm-culture.png"
            alt="Nuun speaker conversation in front of a Paradigm of Culture projection"
          />
          <img
            src="/assets/gallery/nuun-community-attendee.png"
            alt="Community member listening during a Nuun event"
          />
        </div>
        <div class="problem-layout reveal">
          <div>
            <h2 id="problem-title">Complaint without culture becomes a loop.</h2>
            <p>
              Nuun exists to interrupt that loop by making serious thinking, writing, and action
              feel communal, beautiful, and urgent.
            </p>
          </div>
          <div class="problem-list">
            <article>
              <small>Problem 01</small>
              <h3>Dogma</h3>
              <p>When questions become taboo, thought becomes defensive instead of alive.</p>
            </article>
            <article>
              <small>Problem 02</small>
              <h3>Complacency</h3>
              <p>Communities name urgent problems, then fail to build habits of response.</p>
            </article>
            <article>
              <small>Problem 03</small>
              <h3>Fragmentation</h3>
              <p>Energy exists, but it is scattered across rooms that rarely meet.</p>
            </article>
            <article>
              <small>Problem 04</small>
              <h3>Cultural Illiteracy</h3>
              <p>Public life needs shared references, language, and intellectual diet.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <figure class="about-image reveal">
          <img
            src="/assets/media/nuun-event.jpg"
            alt="Nuun speaker holding a microphone at a community gathering"
          />
          <img
            src="/assets/gallery/nuun-community-table.png"
            alt="Three attendees smiling together at a Nuun gathering"
          />
          <img
            src="/assets/gallery/nuun-community-room.png"
            alt="Black and white wide view of a Nuun speaker event"
          />
        </figure>
        <div class="section-body reveal">
          <h2 id="about-title">A community think tank.</h2>
          <p>
            Nuun Collective builds a culture of thinkers who lead, builders who change, and
            collaborators driven by purpose. Through talks, events, and writing sessions, we move
            critical thought toward meaningful action.
          </p>
          <div class="compact-grid">
            <article>
              <h3>Events</h3>
              <p>Speaker conversations, prompts, silent writing, and discussion.</p>
            </article>
            <article>
              <h3>Writing</h3>
              <p>Essays, transcripts, reflections, and published thought.</p>
            </article>
            <article>
              <h3>Media</h3>
              <p>Videos, audio, and transcripts that keep the conversation moving.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="scripture-section" aria-labelledby="mission-title">
        <div class="scripture-card reveal">
          <p class="section-label">The Mission</p>
          <h2 id="mission-title">
            We seek to empower the community through the exertion of the mind
            <span>by way of the pen.</span>
          </h2>
          <blockquote>
            “Nūn. By the Pen, and what they inscribe, you are not [O Muhammad], by
            the grace of your Lord, a madman. And yours shall be an unfailing reward.
            And you indeed are of tremendous character.”
          </blockquote>
          <cite>Qur’an, Surah Al-Qalam 1–4</cite>
        </div>
      </section>

      <section class="section writing-section" id="writing" aria-labelledby="writing-title">
        <div class="section-label reveal">03 / Writing</div>
        <div class="section-body reveal">
          <h2 id="writing-title">Writing that leaves the room.</h2>
          <p>
            Essays, transcripts, and reflections are where the room becomes public record.
            Start with the archive, then follow the conversations as they publish.
          </p>
          <div class="writing-wall">
            <div class="writing-stack">
              <a
                href="https://www.nuuncollective.com/p/nuun-x-oak-cliff-tale-of-two-cities"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/oak-cliff-two-cities.png"
                  alt="Screenshot of the Nuun x Oak Cliff: Tale of Two Cities article"
                />
                <div>
                  <small>Transcript + Video</small>
                  <strong>Nuun x Oak Cliff: Tale of Two Cities</strong>
                </div>
              </a>
              <a
                href="https://www.nuuncollective.com/p/incoherence"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/incoherence.png"
                  alt="Screenshot of the Incoherence article"
                />
                <div>
                  <small>Essay</small>
                  <strong>Incoherence</strong>
                </div>
              </a>
              <a
                href="https://www.nuuncollective.com/p/full-video-and-transcript-nuun-x-506"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/suhaib-webb.png"
                  alt="Screenshot of the NUUN x Sheikh Suhaib Webb transcript"
                />
                <div>
                  <small>Transcript + Video</small>
                  <strong>NUUN x Sheikh Suhaib Webb</strong>
                </div>
              </a>
              <a
                href="https://www.nuuncollective.com/p/nuun-x-dr-yasir-qadhi-x-sheikh-mahdi"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/yasir-mahdi.png"
                  alt="Screenshot of the Nuun x Dr. Yasir Qadhi x Sheikh Mahdi article"
                />
                <div>
                  <small>Featured Transcript + Video</small>
                  <strong>Nuun x Dr. Yasir Qadhi x Sheikh Mahdi</strong>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="section media-section" id="media" aria-labelledby="media-title">
        <div class="section-body reveal">
          <h2 id="media-title">Watch, listen, follow.</h2>
          <p>
            Nuun lives across video, audio, and social clips for people who want the conversation
            before, during, and after the room.
          </p>
          <div class="channel-grid">
            <a href="https://www.youtube.com/channel/UCuCJGcOulNp7St2E5THLN4Q" target="_blank" rel="noreferrer">
              <img src="/assets/screenshots/youtube.png" alt="Screenshot of the Nuun YouTube channel" />
              <div>
                <small>Video</small>
                <strong>YouTube</strong>
                <span>Watch conversations</span>
              </div>
            </a>
            <a href="https://www.instagram.com/nuun.collective/?hl=en" target="_blank" rel="noreferrer">
              <img src="/assets/screenshots/instagram.png" alt="Screenshot of the Nuun Instagram profile" />
              <div>
                <small>Live Updates</small>
                <strong>Instagram</strong>
                <span>Follow the room</span>
              </div>
            </a>
            <a href="https://open.spotify.com/show/7iV1qQqXSdfRFLcmznOgUM" target="_blank" rel="noreferrer">
              <img src="/assets/screenshots/spotify.png" alt="Screenshot of the Nuun Spotify page" />
              <div>
                <small>Audio</small>
                <strong>Spotify</strong>
                <span>Listen to episodes</span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <section class="support" id="support" aria-labelledby="support-title">
        <div class="support-copy reveal">
          <h2 id="support-title">Become a supporter.</h2>
          <p>
            Nuun is completely bootstrapped. Everything so far has been funded by selling
            notebooks, merch, and putting in our own personal money.
          </p>
          <ul class="support-notes" aria-label="Why support Nuun">
            <li>
              <b>$0</b>
              <span>
                <strong>Institutional funding</strong>
                Fully bootstrapped by the team and community support.
              </span>
            </li>
            <li>
              <b>Every dollar</b>
              <span>
                <strong>Covers the work</strong>
                Events, media, publishing, and future programming.
              </span>
            </li>
            <li>
              <b>10+ events</b>
              <span>
                <strong>Real turnout</strong>
                Around 150 people on average; our biggest events have reached 500 attendees.
              </span>
            </li>
          </ul>
          <button class="button button-donate" type="button" data-donate>Donate to Nuun</button>
        </div>
        <div class="support-embed reveal" aria-label="Nuun donation form">
          <div class="embed-frame">
            <!-- CharityStack fundraising progress bar. Keep this exact div once on the page. -->
            <div data-entity="FUNDRAISING_BAR" data-source="CharityStack" id="7f98ee6f-262f-4263-ba45-ddbd899ed38c"></div>
            <!-- CharityStack donation form embed. Keep this exact div once on the page. -->
            <div data-entity="EMBED_FORM" data-source="CharityStack" id="ddabb69a-a264-4677-8bad-614bcc5e8f09"></div>
          </div>
        </div>
      </section>

      <section class="manifesto-section" id="manifesto" aria-labelledby="manifesto-title">
        <div class="manifesto-inner reveal">
          <h2 id="manifesto-title" class="manifesto-lines">
            We believe <span>writing</span> is not passive.<br />
            We believe conversation should move people.<br />
            We believe thought becomes <span>culture</span>, and culture becomes
            <span>action</span>.
          </h2>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="brand-logo small" href="#top" aria-label="Nuun Collective home">
        <img src="/assets/logos/nuun-wordmark-orange.png" alt="Nuun" />
      </a>
      <nav aria-label="Footer navigation">
        <a href="https://www.instagram.com/nuun.collective/" target="_blank" rel="noreferrer">Instagram</a>
        <a href="https://www.nuuncollective.com/" target="_blank" rel="noreferrer">Substack</a>
        <a href="https://www.youtube.com/channel/UCuCJGcOulNp7St2E5THLN4Q" target="_blank" rel="noreferrer">YouTube</a>
        <a href="https://open.spotify.com/show/7iV1qQqXSdfRFLcmznOgUM" target="_blank" rel="noreferrer">Spotify</a>
        <button type="button" data-donate>Donate</button>
      </nav>
      <p>Nuun Collective / Dallas / Thinking / Writing / Action</p>
      <p>© 2026 Nuun Collective. All rights reserved.</p>
    </footer>
  </body>
</html>
