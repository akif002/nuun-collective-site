---
import DepthIntro from "../components/DepthIntro.astro";
import ChapterHeading from "../components/ChapterHeading.astro";
import HeroPenLogo from "../components/HeroPenLogo";
import "../styles/global.css";
import "../styles/edition.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Nuun Collective is a Dallas-based Muslim community think tank for events, writing, media, and action."
    />
    <title>Nuun Collective</title>
    <link rel="preload" href="/assets/gallery/nuun-gallery-05.webp" as="image" fetchpriority="high" />
    <link rel="preload" href="/assets/fonts/korolev-medium.otf" as="font" type="font/otf" crossorigin />
    <!-- Start of CharityStack Embed -->
    <script
      type="text/javascript"
      defer
      id="charitystack-embed"
      data-id="org_VWighWRyUt"
      src="https://prod-donation-elements-b-donationelementsjsfilesb-1m4f4dl6p6b21.s3.us-east-2.amazonaws.com/bundle.js"
      is:inline
    ></script>
    <!-- End of CharityStack Embed-->
    <script defer src="/script.js" is:inline></script>
  </head>
  <body class="edition">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" data-header>
      <a class="brand-logo small" href="#top" aria-label="Nuun Collective home">
        <img src="/assets/logos/nuun-wordmark-orange.png" alt="Nuun" />
      </a>
      <nav class="desktop-nav" aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#writing">Writing</a>
        <a href="#media">Media</a>
        <a href="#support">Donate</a>
      </nav>
      <div class="header-actions">
        <button class="button button-donate" type="button" data-donate>Donate</button>
        <a
          class="button button-follow header-follow"
          href="https://www.instagram.com/nuun.collective/"
          target="_blank"
          rel="noreferrer"
        >
          Follow
        </a>
      </div>
    </header>

    <main id="main">
      <DepthIntro />
      <nav class="chapter-nav" aria-label="Explore Nuun">
        <a href="#top" data-chapter="top">Nuun Collective</a>
        <a href="#about" data-chapter="about">Learn, Discuss, Build</a>
        <a href="#writing" data-chapter="writing">Read</a>
        <a href="#media" data-chapter="media">Listen</a>
        <a href="#support" data-chapter="support">Support</a>
      </nav>

      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-inner">
          <div class="hero-logo reveal">
            <HeroPenLogo className="hero-pen-logo" client:visible />
          </div>

          <div class="hero-copy reveal">
            <h2 id="hero-title">A community shaped<br />by its conversations.</h2>
            <p class="hero-subtext">
              Talks, writing, and shared work.<br />Rooted in the Muslim community. Made in Dallas.
            </p>
            <div class="actions">
              <a class="button button-secondary" href="https://www.nuuncollective.com/" target="_blank" rel="noreferrer">
                Read Nuun
              </a>
              <button class="button button-donate" type="button" data-donate>Donate</button>
            </div>
          </div>

        </div>
      </section>

      <section class="section problem-section" id="problem" aria-labelledby="problem-title">
        <div class="problem-copy reveal">
          <h2 id="problem-title">A place to think together.</h2>
          <p>
            Muslim communities need space for difficult questions and honest disagreement.
            Nuun offers a place to examine those questions together.
          </p>
          <p>
            Through talks, reading, and writing, we connect questions of faith and culture
            to the responsibilities of community life in Dallas.
          </p>
        </div>
      </section>

      <section class="section about-section" id="about" aria-labelledby="about-title">
        <ChapterHeading id="about-title" title="Learn, Discuss, Build" image="/assets/gallery/Nuun5Suad-36.webp" alt="A woman speaking into a microphone during a Nuun discussion" position="50% 40%" />
        <figure class="about-image reveal">
          <button type="button" class="gallery-trigger" data-lightbox-src="/assets/media/nuun-event.jpg" data-lightbox-alt="Nuun speaker holding a microphone at a community gathering">
            <img src="/assets/media/nuun-event.jpg" alt="Nuun speaker holding a microphone at a community gathering" loading="lazy" decoding="async" />
          </button>
          <button type="button" class="gallery-trigger" data-lightbox-src="/assets/gallery/nuun-community-table.png" data-lightbox-alt="Three attendees smiling together at a Nuun gathering">
            <img src="/assets/gallery/nuun-community-table.png" alt="Three attendees smiling together at a Nuun gathering" loading="lazy" decoding="async" />
          </button>
        </figure>
        <div class="section-body reveal">
          <h3 class="editorial-heading">A community think tank.</h3>
          <p>
            Nuun is a community think tank in Dallas. Our talks and writing sessions
            bring Muslims with different experiences into the same conversation.
          </p>
          <div class="compact-grid">
            <article>
              <h3>Events</h3>
              <p>Speaker conversations, prompts, silent writing, and discussion.</p>
            </article>
            <article>
              <h3>Writing</h3>
              <p>Essays by community members and transcripts of our talks.</p>
            </article>
            <article>
              <h3>Media</h3>
              <p>Recordings for anyone who couldn’t be there.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="scripture-section" aria-labelledby="mission-title">
        <div class="scripture-card reveal">
          <p class="section-label">The Mission</p>
          <h2 id="mission-title">
            We seek to empower the community through the exertion of the mind
            <span>by way of the pen.</span>
          </h2>
          <blockquote>
            “Nūn. By the Pen, and what they inscribe, you are not [O Muhammad], by
            the grace of your Lord, a madman. And yours shall be an unfailing reward.
            And you indeed are of tremendous character.”
          </blockquote>
          <cite>Qur’an, Surah Al-Qalam 1–4</cite>
        </div>
      </section>

      <section class="section writing-section" id="writing" aria-labelledby="writing-title">
        <ChapterHeading id="writing-title" title="Read." image="/assets/gallery/Nuun5Suad-16.webp" alt="Community members reading together at a Nuun gathering" position="50% 50%" />
        <div class="section-body reveal">
          <h3 class="editorial-heading">Essays and conversations.</h3>
          <p>
            Read essays by community members and transcripts of our talks.
          </p>
          <div class="writing-wall">
            <div class="writing-stack">
              <a
                href="https://www.nuuncollective.com/p/nuun-x-oak-cliff-tale-of-two-cities"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/oak-cliff-two-cities.webp"
                  alt="Screenshot of the Nuun x Oak Cliff: Tale of Two Cities article"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <small>Transcript + Video</small>
                  <strong>Nuun x Oak Cliff: Tale of Two Cities</strong>
                </div>
              </a>
              <a
                href="https://www.nuuncollective.com/p/incoherence"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/incoherence.webp"
                  alt="Screenshot of the Incoherence article"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <small>Essay</small>
                  <strong>Incoherence</strong>
                </div>
              </a>
              <a
                href="https://www.nuuncollective.com/p/full-video-and-transcript-nuun-x-506"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/suhaib-webb.webp"
                  alt="Screenshot of the NUUN x Sheikh Suhaib Webb transcript"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <small>Transcript + Video</small>
                  <strong>NUUN x Sheikh Suhaib Webb</strong>
                </div>
              </a>
              <a
                href="https://www.nuuncollective.com/p/nuun-x-dr-yasir-qadhi-x-sheikh-mahdi"
                target="_blank"
                rel="noreferrer"
              >
                <img
                  src="/assets/screenshots/yasir-mahdi.webp"
                  alt="Screenshot of the Nuun x Dr. Yasir Qadhi x Sheikh Mahdi article"
                  loading="lazy"
                  decoding="async"
                />
                <div>
                  <small>Featured Transcript + Video</small>
                  <strong>Nuun x Dr. Yasir Qadhi x Sheikh Mahdi</strong>
                </div>
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="section media-section" id="media" aria-labelledby="media-title">
        <ChapterHeading id="media-title" title="Listen." image="/assets/gallery/R61_8181-Enhanced-NR.webp" alt="A view from the panel into the audience at a Nuun conversation" position="50% 50%" />
        <div class="section-body reveal">
          <h3 class="editorial-heading">Watch or listen.</h3>
          <p>
            Full talks on YouTube and Spotify. Upcoming gatherings on Instagram.
          </p>
          <div class="channel-grid">
            <a href="https://www.youtube.com/channel/UCuCJGcOulNp7St2E5THLN4Q" target="_blank" rel="noreferrer">
              <img src="/assets/screenshots/youtube.webp" alt="Screenshot of the Nuun YouTube channel" loading="lazy" decoding="async" />
              <div>
                <small>Video</small>
                <strong>YouTube</strong>
                <span>Watch conversations</span>
              </div>
            </a>
            <a href="https://www.instagram.com/nuun.collective/?hl=en" target="_blank" rel="noreferrer">
              <img src="/assets/screenshots/instagram.webp" alt="Screenshot of the Nuun Instagram profile" loading="lazy" decoding="async" />
              <div>
                <small>Live Updates</small>
                <strong>Instagram</strong>
                <span>Follow the room</span>
              </div>
            </a>
            <a href="https://open.spotify.com/show/7iV1qQqXSdfRFLcmznOgUM" target="_blank" rel="noreferrer">
              <img src="/assets/screenshots/spotify.webp" alt="Screenshot of the Nuun Spotify page" loading="lazy" decoding="async" />
              <div>
                <small>Audio</small>
                <strong>Spotify</strong>
                <span>Listen to episodes</span>
              </div>
            </a>
          </div>
        </div>
      </section>

      <section class="support" id="support" aria-labelledby="support-title">
        <div class="support-copy reveal">
          <h2 id="support-title">Help fund the next<br />Nuun gathering.</h2>
          <p>
            Nuun runs on community support, notebook and merch sales, and the team’s own money.
            Donations pay for gatherings, recordings, and publishing.
          </p>
          <ul class="support-notes" aria-label="Why support Nuun">
            <li>
              <b>$0</b>
              <span>
                <strong>Built without institutional funding</strong>
                The team and community have funded Nuun from the start.
              </span>
            </li>
            <li>
              <b>Your gift</b>
              <span>
                <strong>Funds events and publishing</strong>
                Help us host gatherings and make the talks and writing available.
              </span>
            </li>
            <li>
              <b>10+ events</b>
              <span>
                <strong>People are showing up</strong>
                About 150 attendees on average; up to 500 at our largest events.
              </span>
            </li>
          </ul>
          <!-- CharityStack fundraising progress bar. Keep this exact div once on the page. -->
          <div data-entity="FUNDRAISING_BAR" data-source="CharityStack" id="7f98ee6f-262f-4263-ba45-ddbd899ed38c"></div>
        </div>
        <div class="support-embed reveal" aria-label="Nuun donation form">
          <div class="embed-frame">
            <!-- CharityStack donation form embed. Keep this exact div once on the page. -->
            <div data-entity="EMBED_FORM" data-source="CharityStack" id="ddabb69a-a264-4677-8bad-614bcc5e8f09"></div>
          </div>
        </div>
      </section>

    </main>

    <dialog class="image-lightbox" data-image-lightbox aria-label="Expanded gallery image">
      <button class="image-lightbox-close" type="button" data-lightbox-close aria-label="Close image viewer">×</button>
      <img data-lightbox-image alt="" />
    </dialog>

    <footer class="site-footer">
      <a class="brand-logo small" href="#top" aria-label="Nuun Collective home">
        <img src="/assets/logos/nuun-wordmark-orange.png" alt="Nuun" />
      </a>
      <nav aria-label="Footer navigation">
        <a href="https://www.instagram.com/nuun.collective/" target="_blank" rel="noreferrer">Instagram</a>
        <a href="https://www.nuuncollective.com/" target="_blank" rel="noreferrer">Substack</a>
        <a href="https://www.youtube.com/channel/UCuCJGcOulNp7St2E5THLN4Q" target="_blank" rel="noreferrer">YouTube</a>
        <a href="https://open.spotify.com/show/7iV1qQqXSdfRFLcmznOgUM" target="_blank" rel="noreferrer">Spotify</a>
        <button type="button" data-donate>Donate</button>
      </nav>
      <p>Nuun Collective / Dallas / Thinking / Writing / Action</p>
      <p>© 2026 Nuun Collective. All rights reserved.</p>
    </footer>
    <script>
      import "../scripts/chapter-nav.js";
    </script>
  </body>
</html>
