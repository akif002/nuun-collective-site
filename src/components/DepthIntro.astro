<section class="depth-intro is-animated" id="top" data-depth-intro aria-label="Nuun event photo intro">
  <div class="depth-stage">
    <canvas class="depth-canvas" data-depth-canvas aria-hidden="true"></canvas>
    <div class="depth-vignette" aria-hidden="true"></div>

    <div class="depth-copy">
      <p class="intro-location">Nuun Collective · Dallas</p>
      <h1>A culture<br />of thought.</h1>
      <p class="intro-note">Narratives script human behavior,<br />how code scripts computers.</p>
    </div>
    <a class="depth-enter" href="#about">Explore the collective <span aria-hidden="true">↓</span></a>

    <div class="depth-fallback" data-depth-fallback>
      {
        galleryImages.map((image, index) => (
          <img src={index === 0 ? image.src : undefined} data-src={index === 0 ? undefined : image.src} alt={image.alt} width={image.width} height={image.height} loading={index === 0 ? "eager" : "lazy"} decoding={index === 0 ? "sync" : "async"} fetchpriority={index === 0 ? "high" : "auto"} />
        ))
      }
    </div>
  </div>
</section>

<script>
  import initDepthGallery from "../scripts/depth-gallery.js";

  initDepthGallery();
</script>
