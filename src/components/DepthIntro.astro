<section class="depth-intro" id="top" data-depth-intro aria-label="Nuun event photo intro">
  <div class="depth-stage">
    <canvas class="depth-canvas" data-depth-canvas aria-hidden="true"></canvas>

    <div class="depth-vignette" aria-hidden="true"></div>

    <div class="depth-copy">
      <h1>Narratives script human behavior, how code scripts computers.</h1>
      <span>Scroll to enter</span>
    </div>

    <div class="depth-fallback" data-depth-fallback>
      {
        galleryImages.map((image, index) => (
          <img src={image.src} alt={image.alt} loading={index < 2 ? "eager" : "lazy"} />
        ))
      }
    </div>
  </div>
</section>

<script>
